# Copy to .env and fill in. .env is gitignored -- verified with `git check-ignore`.
# Nothing in tests/ reads these; the offline suite must pass with none of them set.

# Generation, LLM judging, and the long-context baseline.
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Overflow judge when the Gemini daily request quota is exhausted.
# Free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Only needed to publish the eval set as a dataset, not to run anything.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# SEC EDGAR requires a declared User-Agent naming a real contact, or it returns
# 403. This is a documented access condition, not a workaround.
# Format: "Name email@example.com"
EDGAR_USER_AGENT=
