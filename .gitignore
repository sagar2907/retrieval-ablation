# --- Secrets -----------------------------------------------------------------
# Must be the first rule and must never be narrowed. Phase 1 verifies this with
# `git check-ignore` before any key is written to disk.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# --- Tooling caches ----------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# --- Corpus and derived artifacts -------------------------------------------
# The raw corpus is ~20 GB of filings and is fully reproducible from
# manifests committed under data/manifests/, so it stays out of git.
data/raw/
data/interim/
data/indexes/
data/qdrant/
models/

# The API response cache is content-hash keyed and can be large. Excluded so a
# clone never inherits stale judge output that would silently skip real calls.
.cache/

# GPU artifacts. Derived data, hundreds of megabytes, and fully reproducible from
# notebooks/kaggle_gpu_arms.py. The much smaller cross-encoder scores ARE tracked,
# because they are what the reranking rows in the published table rest on.
results/vectors-*.npz
results/queryvectors-*.npz
# Pre-backfill copies written by scripts/backfill_query_texts.py. Derived,
# large, and regenerable; kept on disk only so a bad backfill can be undone.
results/*.npz.bak

# Copying a Kaggle output folder wholesale brings the notebook''s entire working
# directory with it, including a full clone of this repository (8.5 GB, with its
# own .git and a second copy of the corpus). Harmless to leave on disk, disastrous
# to commit.
#
# Ignore every DIRECTORY under results/ rather than naming them one at a time.
# results/ holds published metric files and nothing else, so any directory
# appearing there is a dropped download. Naming them individually failed the
# second time it mattered: the rule below said results/retrieval-ablation/, the
# next download unpacked to results/results/, and 8.6 GB sat unignored waiting
# for a `git add -A`. Artifacts that should be committed are copied up into
# results/ explicitly, which is the intended workflow anyway.
results/*/

# Page rasters written by scripts/render_pdf.py so the rendering can be checked
# by eye. They are a verification step, not an output: regenerated on every run,
# and the PDF they were produced from is tracked right next to them.
docs/_preview/

# --- Deliberately NOT ignored ------------------------------------------------
# data/eval/       the labelled retrieval benchmark  -- this is the artifact
# data/manifests/  corpus checksums for reproducibility
# results/         ablation tables and metric outputs

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
